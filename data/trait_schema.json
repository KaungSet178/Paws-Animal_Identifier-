    "source_required_for_nonblank_values": true,
    "dataset_missing_representation": "blank",
    "user_not_sure_representation": "unknown",
    "unknown_is_neutral_evidence": true,
    "do_not_infer_from_taxonomic_name": true,
    "do_not_require_wildlife_capture_or_handling": true,
    "no_measurement_questions": true,
    "questions_should_be_answerable_from_quick_sighting_or_ordinary_photo": true,
    "species_level_result_not_guaranteed": true,
    "color_traits_are_low_weight": true
